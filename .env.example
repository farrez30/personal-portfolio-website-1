# Copy to .env.local and fill in real values. All are optional — the contact
# form falls back to the values baked into components/contact/Contact.jsx.

# EmailJS (https://dashboard.emailjs.com) — used by "Send via Email".
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# WhatsApp number (country code, digits only, no + or spaces) — used by
# "Send via WhatsApp". Example: 6285884061543
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Canonical site URL for SEO metadata (defaults to https://farrez.vercel.app).
NEXT_PUBLIC_SITE_URL=

# Spotify Web API, server only (ADR 0010): track list of the playlist in
# content/musik.js for the music CD booklet. Without these the booklet just
# has no track list. Client ID and secret come from developer.spotify.com/dashboard;
# the refresh token from `node scripts/spotify-token.mjs`. Never prefix with NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
